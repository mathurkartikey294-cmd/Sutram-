# ==============================================================================
# SUTRAM Environment Configuration
# Copy this file to .env before starting the platform
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API & Server Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Forensic Storage Paths
EVIDENCE_STORE_PATH=./evidence_store/originals
WORKING_COPY_PATH=./evidence_store/working
ARTIFACTS_PATH=./evidence_store/artifacts
REPORTS_PATH=./evidence_store/reports

# Storage Lifecycle & Security
WORKING_COPY_TTL_HOURS=24
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=900

# Database Configuration
DATABASE_URL=sqlite:///./backend/sutram.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://sutram_user:sutram_pass@localhost:5432/sutram_db

# Cryptographic Keys (Required for tamper-evident report signing & JWT auth)
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY=sutram_development_jwt_insecure_secret_key_change_in_production_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Report Cryptographic Signing (HMAC-SHA256 or Ed25519)
REPORT_SIGNING_KEY=sutram_report_signing_key_replace_with_secure_hex_in_prod
REPORT_SIGNING_ALGORITHM=HMAC-SHA256

# Forensic Operational Flags
# MOCK_MODE: When true, heavy ML models (deep classifiers, wav2vec, rPPG) return deterministic
# sample results clearly labelled [MOCK]. Set to false when pretrained weights are installed.
MOCK_MODE=true

# Device & Acceleration
DEVICE=cpu
TORCH_NUM_THREADS=4

# Subsystem Feature Flags
ENABLE_PRNU_EXPERIMENTAL=false
ENABLE_LIGHTING_EXPERIMENTAL=false
ENABLE_RPPG=true
ENABLE_LIPSYNC=true
ENABLE_WAV2VEC=true
ENABLE_C2PA_VERIFICATION=true

# External Tool Executables (Defaults search system PATH)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
EXIFTOOL_BINARY=exiftool
C2PATOOL_BINARY=c2patool

# Default Agency / Officer Info (Used for report stamping when unspecified)
DEFAULT_AGENCY_NAME=Central Forensic Science Laboratory
DEFAULT_UNIT_NAME=Digital Forensics and Cyber Crime Unit
